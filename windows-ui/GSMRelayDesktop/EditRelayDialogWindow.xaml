<Window x:Class="GSMRelayDesktop.EditRelayDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit relay"
        Height="350"
        Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
  <Border Margin="12" Padding="12" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock Grid.Row="0" Text="Editare releu" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

      <StackPanel Grid.Row="1" Margin="0,0,0,8">
        <TextBlock Text="Nume" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBox x:Name="RelayNameTextBox" Margin="0,2,0,0"/>
      </StackPanel>

      <StackPanel Grid.Row="2" Margin="0,0,0,8">
        <TextBlock Text="Telefon releu" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBox x:Name="RelayPhoneTextBox" Margin="0,2,0,0"/>
      </StackPanel>

      <StackPanel Grid.Row="3" Margin="0,0,0,8">
        <TextBlock Text="Parola (4 cifre)" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBox x:Name="RelayPasswordTextBox" Margin="0,2,0,0"/>
      </StackPanel>

      <StackPanel Grid.Row="4" Margin="0,0,0,0">
        <TextBlock Text="Locatie" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBox x:Name="RelayLocationTextBox" Margin="0,2,0,10"/>
        <WrapPanel>
          <Button Content="Salveaza" Click="Save_Click" Margin="0,0,8,0" Padding="12,6"/>
          <Button Content="Anuleaza" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" Padding="12,6"/>
        </WrapPanel>
      </StackPanel>
    </Grid>
  </Border>
</Window>
