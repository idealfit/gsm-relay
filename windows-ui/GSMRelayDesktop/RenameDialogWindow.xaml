<Window x:Class="GSMRelayDesktop.RenameDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename"
        Height="210"
        Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource SurfaceBrush}">
  <Border Margin="12" Padding="12" Background="White" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <TextBlock x:Name="PromptTextBlock" Grid.Row="0" Text="Nume nou" FontWeight="SemiBold" Margin="0,0,0,8"/>
      <TextBox x:Name="ValueTextBox" Grid.Row="1" Margin="0,0,0,12"/>

      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Anuleaza" Click="Cancel_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Padding="12,6"/>
        <Button Content="Salveaza" Click="Save_Click" Padding="12,6"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
